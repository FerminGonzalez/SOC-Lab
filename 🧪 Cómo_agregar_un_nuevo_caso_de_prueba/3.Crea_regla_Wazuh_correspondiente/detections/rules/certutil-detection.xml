<group name="custom,windows,command_and_control">
  <rule id="100103" level="8">
    <if_sid>60000</if_sid>
    <field name="win.eventdata.commandLine">certutil\.exe.*-urlcache.*-f</field>
    <description>Possible certutil download activity detected (T1105)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>command_and_control,certutil,</group>
  </rule>
</group>
