<group name="custom,windows,credential_access">
  <rule id="100100" level="12">
    <if_sid>60000</if_sid>              <!-- sysmon Event ID 1 -->
    <field name="win.eventdata.commandLine">sekurlsa::logonpasswords</field>
    <description>Possible Mimikatz credential dumping (T1003.001)</description>
    <mitre>
      <id>T1003.001</id>
      <id>T1059.001</id>
    </mitre>
  </rule>
</group>
